{
  "name": "brick-classico",
  "version": "2.0.0",
  "description": "Brick Breaker clássico — 1000 níveis, combos épicos, 7 vidas",
  "main": "server.js",
  "scripts": {
    "serve": "node server.js",
    "dev": "npx cap run android -l --external",
    "build": "npx cap sync && npx cap build android",
    "build:apk": "npx cap sync && cd android && ./gradlew assembleDebug",
    "build:aab": "npx cap sync && cd android && ./gradlew bundleRelease",
    "open:android": "npx cap open android",
    "sync": "npx cap sync",
    "add:android": "npx cap add android"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/eliassebastiao/ezzogame.git"
  },
  "author": "EZZO Maquina",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/core": "^6.1.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/preferences": "^6.0.0",
    "@capacitor/screen-orientation": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "pg": "^8.21.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.0"
  }
}
